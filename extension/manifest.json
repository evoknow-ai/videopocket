{
  "manifest_version": 3,
  "name": "VideoPocket",
  "version": "0.4.6",
  "description": "Save videos and Instagram images you are authorized to download from supported social posts.",
  "permissions": ["activeTab", "alarms", "downloads", "storage", "scripting"],
  "host_permissions": [
    "https://x.com/*", "https://twitter.com/*",
    "https://www.facebook.com/*", "https://web.facebook.com/*",
    "https://www.instagram.com/*",
    "http://127.0.0.1:17839/*",
    "https://raw.githubusercontent.com/evoknow-ai/videopocket/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "VideoPocket",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [{
    "matches": [
      "https://x.com/*", "https://twitter.com/*", "https://www.facebook.com/*", "https://web.facebook.com/*",
      "https://www.instagram.com/*"
    ],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }]
}
